# Docker help commands

o sudo apt install docker.io
o sudo docker -v
o sudo systemctl status docker
o sudo docker version -> check the Docker Client and Docker o Server information.
o docker -> get all the commands related to docker
o docker image --help
o sudo docker info
o sudo docker search httpd -> search docker images
o sudo docker run -d --name webpage3 http
o sudo docker stop container_name
o sudo docker rm container_name
o sudo docker pull ubuntu:lunar-20230816
o sudo docker build -t tag_name .
o sudo docker run -p 3000:3000 shop-backend
o sudo usermod -aG docker $USER -> grant permission
o sudo docker exec -it my-container /bin/sh

